{
  "name": "solana-local-quoter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Solana quote engine and quote server: deployed DEX programs simulated in LiteSVM against mirrored RPC state",
  "scripts": {
    "quote": "tsx src/local-quote.ts",
    "quote-server": "tsx src/quote-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@solana/kit": "^2.3.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@triton-one/yellowstone-grpc": "^9.0.0",
    "dotenv": "^17.2.3",
    "litesvm": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
