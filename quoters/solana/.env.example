# HTTP RPC (with websocket support for the quote server). Chainstack and most paid RPCs work.
SOLANA_RPC_URL=
# Optional websocket endpoint; defaults to the Helius URL or SOLANA_RPC_URL with ws://
SOLANA_WS_URL=
# Helius URL with ?api-key=; serves the getProgramAccounts scans that discover PancakeSwap, Manifest,
# GoonFi, JupLend, BisonFi and Kipseli pools (many RPC plans refuse those scans).
HELIUS_RPC_URL=
# Optional comma-separated HTTP backups
SOLANA_RPC_URL_BACKUP=
RPC_TIMEOUT_MS=20000
RPC_MAX_ATTEMPTS=3

# Quote server (npm run quote-server). See README "Local quote server".
QUOTE_PAIRS=USDG/USDC,PYUSD/USDC,PYUSD/USDG,USDT/USDC
QUOTE_VIA=
QUOTE_SERVER_HOST=127.0.0.1
QUOTE_SERVER_PORT=8787
# Required (16+ characters) only to listen beyond loopback; clients send Authorization: Bearer TOKEN
QUOTE_SERVER_TOKEN=
